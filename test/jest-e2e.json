{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testRegex": "test/.*\\.spec\\.ts$",
  "testPathIgnorePatterns": ["/node_modules/", "/dist/", "/.claude/"],
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "transformIgnorePatterns": [
    "node_modules/(?!(jose|uuid)/)"
  ],
  "testEnvironment": "node",
  "testTimeout": 30000
}
